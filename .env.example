TREEMIND_DATA_DIR=./data
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# Local chat, memory-summary, and tree-label model.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
# Dedicated semantic model. Run: ollama pull nomic-embed-text
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# Laya retrieval router. Keep preload false for fast API startup; checkpoints load on first route.
LAYA_DEVICE=cpu
LAYA_PRELOAD=false
# Per-conversation active working memory. 100k remains below the model's 131k context capacity.
CONTEXT_WINDOW_TOKENS=100000
CONTEXT_RETAIN_TOKENS=10000
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=
